        "html2canvas": "^1.4.1",
        "next": "^16.2.10",
        "postcss": "8.5.8",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-icons": "^5.7.0",
        "react-toastify": "^11.1.0",
        "sharp": "^0.34.5",
        "swr": "^2.4.2",
        "tailwindcss": "^4.3.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "26.4.1",
        "@types/react": "^19.2.17",
        "globals": "^17.7.0",
        "oxfmt": "^0.41.0",
