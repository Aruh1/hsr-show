# Environment Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# Public Configuration (exposed to client)
# ===========================================

# Base URL for the application (used for metadata and SEO)
NEXT_PUBLIC_BASE_URL=https://hsr.pololer.my.id

# CDN URL for Star Rail resources (default: Mar-7th's StarRailRes)
NEXT_PUBLIC_ASSET_URL=https://cdn.jsdelivr.net/gh/Mar-7th/StarRailRes@master/

# Google Site Verification (for SEO)
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ===========================================
# Server Configuration (not exposed to client)
# ===========================================

# Mihomo API endpoint
MIHOMO_API_URL=https://api.mihomo.me

# Enka API endpoint (fallback)
ENKA_API_URL=https://enka.network

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Cache configuration (in seconds)
CACHE_TTL_SECONDS=60
